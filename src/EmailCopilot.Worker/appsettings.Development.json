{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Imap": {
    "AuthenticationMode": "MicrosoftOAuthDeviceCode",
    "EnableProtocolLogging": false,
    "SelectionWindowSize": 100,
    "PreferredBatchSize": 2000
  },
  "Llm": {
    "UseMock": false,
    "AvoidFilter": {
      "Enabled": true
    }
  },
  "Embedding": {
    "Enabled": true
  },
  "StyleProfile": {
    "RebuildOnStartup": false
  },
  "Worker": {
    "Enabled": true,
    "MaxDraftsPerRun": 10
  },
  "WebUi": {
    "Enabled": true
  }
}
